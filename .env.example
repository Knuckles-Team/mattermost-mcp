# Mattermost Server API v4 endpoint URL
MATTERMOST_URL=http://localhost:8065
# Personal Access Token or Bot Token
MATTERMOST_TOKEN=mattermost_api_access_token
# Fallback API base URL (used when MATTERMOST_URL is unset)
MATTERMOST_MCP_BASE_URL=http://localhost:8065
# Username for login-based auth (alternative to token)
MATTERMOST_MCP_USERNAME=mattermost_username
# Password for login-based auth (alternative to token)
MATTERMOST_MCP_PASSWORD=mattermost_password
# Verify TLS certificates for the Mattermost connection

# --- Tool Toggle Switches (per-domain <DOMAIN>TOOL; set False to disable) ---
# These names match the authoritative "Toggle Env Var" column in the README
# MCP tools table (condensed action-routed surface).

# --- Service TLS profile selection (optional) ---

# --- Governed ingestion tools (enabled unless False) ---
KGTOOL=True

# --- Operator-approved immutable Compose images ---
# Required for the corresponding Compose deployment: image@sha256:digest.
MATTERMOST_MCP_MCP_IMAGE=

# --- Source generator inputs; not required to run the connector ---
# Required when running generate_mattermost_mcp.py.
MATTERMOST_OPENAPI_SOURCE=
# Optional output override; when unset, defaults to the repository package directory.
# MATTERMOST_MCP_PACKAGE_DIR=./mattermost_mcp
